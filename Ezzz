Instance.new("UICorner", box)

------------------------------------------------
-- 📋 ปุ่ม Copy
------------------------------------------------
local copyBtn = Instance.new("TextButton")
copyBtn.Size = UDim2.new(1,0,0,45)
copyBtn.Position = UDim2.new(0,0,0,120)
copyBtn.Text = "COPY"
copyBtn.BackgroundColor3 = Color3.fromRGB(50,200,120)
copyBtn.TextColor3 = Color3.fromRGB(255,255,255)
copyBtn.Parent = scroll
Instance.new("UICorner", copyBtn)

------------------------------------------------
-- 🎛️ เปิด / ปิด UI
------------------------------------------------
local open = false

openBtn.MouseButton1Click:Connect(function()
	open = not open
	frame.Visible = open
end)

------------------------------------------------
-- 📍 Get Position (เฉพาะตัวเลข)
------------------------------------------------
getBtn.MouseButton1Click:Connect(function()
	local char = player.Character
	if not char then return end

	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local p = root.Position

	box.Text = tostring(math.floor(p.X)) .. "," ..
		tostring(math.floor(p.Y)) .. "," ..
		tostring(math.floor(p.Z))
end)

------------------------------------------------
-- 📋 Copy (เลือกแล้วกด copy ได้)
------------------------------------------------
copyBtn.MouseButton1Click:Connect(function()
	box:CaptureFocus()
	box.SelectionStart = 1
	box.CursorPosition = #box.Text + 1
end)

------------------------------------------------
-- 🧲 ลาก UI ได้
------------------------------------------------
local dragging = false
local dragStart, startPos

top.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = frame.Position
	end
end)

top.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		frame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)
