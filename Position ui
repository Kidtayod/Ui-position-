-- 🎛️ เปิด / ปิด UI
------------------------------------------------
local open = false

local function toggleUI(state)
	main.Visible = true
	local goal = {}

	if state then
		main.Size = UDim2.new(0, 0, 0, 0)
		goal.Size = UDim2.new(0, 320, 0, 220)
	else
		goal.Size = UDim2.new(0, 0, 0, 0)
	end

	local tween = TweenService:Create(
		main,
		TweenInfo.new(0.25, Enum.EasingStyle.Quad),
		goal
	)

	tween:Play()

	if not state then
		task.wait(0.25)
		main.Visible = false
	end
end

openButton.MouseButton1Click:Connect(function()
	open = not open
	toggleUI(open)
end)

close.MouseButton1Click:Connect(function()
	open = false
	toggleUI(false)
end)

posButton.MouseButton1Click:Connect(function()
	local char = player.Character
	if not char then return end

	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local p = root.Position
	label.Text = string.format("X: %d | Y: %d | Z: %d",
		math.floor(p.X),
		math.floor(p.Y),
		math.floor(p.Z)
	)
end)

------------------------------------------------
-- 🖱️ ระบบลาก UI (ตัวหลัก)
------------------------------------------------
local function makeDraggable(frame, dragPart)
	local dragging = false
	local dragStart, startPos

	dragPart.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
		end
	end)

	dragPart.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

